# Port for local development (Cloud Run sets this automatically in production)
PORT=8080

# GCP Project configuration
GOOGLE_CLOUD_PROJECT=penni-ai-platform
FIREBASE_PROJECT_ID=penni-ai-platform
STORAGE_BUCKET=penni-ai-platform.firebasestorage.app

# Environment
NODE_ENV=development
# Logging
LOG_LEVEL=debug

# API Keys (use Secret Manager in production)
# Get from GCP Console > Secret Manager
OPENAI_API_KEY=sk-...
WEAVIATE_API_KEY=...
WEAVIATE_URL=https://...
DEEPINFRA_API_KEY=...
BRIGHTDATA_API_KEY=...

# Service Configuration
WEAVIATE_COLLECTION_NAME=influencer_profiles
DEEPINFRA_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
OPENAI_MODEL=gpt-4o-mini
PIPELINE_TASKS_BASE_URL=http://localhost:8080
CLOUD_TASKS_LOCATION=us-central1
CLOUD_TASKS_SERVICE_ACCOUNT_EMAIL=
CLOUD_TASKS_OIDC_AUDIENCE=
PIPELINE_TASKS_QUEUE_STAGE=pipeline-stage
PIPELINE_TASKS_QUEUE_BATCH=pipeline-batch
PIPELINE_TASKS_QUEUE_POLL=pipeline-poll
PIPELINE_TASKS_DIRECT=false

# Performance Tuning
MAX_CONCURRENT_WEAVIATE_SEARCHES=12
MAX_CONCURRENT_LLM_REQUESTS=5
WEAVIATE_REQUEST_TIMEOUT_MS=120000

# BrightData Configuration
BRIGHTDATA_BASE_URL=https://api.brightdata.com/datasets/v3
BRIGHTDATA_INSTAGRAM_DATASET_ID=gd_l1vikfch901nx3by4
BRIGHTDATA_TIKTOK_DATASET_ID=gd_l1villgoiiidt09ci
BRIGHTDATA_BATCH_SIZE=20
BRIGHTDATA_MAX_IN_FLIGHT=5

# Note: In production, these values are set by Cloud Run
# API keys and secrets are accessed via Secret Manager using the service account
# For local development, copy this file to .env and add actual API keys if needed
