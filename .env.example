# Environment Variables for SvelteKit Application
# This file documents environment variables for the SvelteKit app.
# Note: Cloud Functions and Cloud Run services have their own .env files:
# - functions/.env.example
# - services/pipeline-service/.env.example

# ==============================================================================
# Cloud Run Configuration
# ==============================================================================

# Cloud Run pipeline service URL
# Required for pipeline operations
# Get this URL after deploying the pipeline service:
# gcloud run services describe pipeline-service --region=us-central1 --format='value(status.url)'
# Current production URL:
CLOUD_RUN_PIPELINE_SERVICE_URL=https://pipeline-service-szs2cmou6q-uc.a.run.app

# ==============================================================================
# Notes
# ==============================================================================

# For local development:
# 1. Copy this file to .env
# 2. Update the values as needed for your local environment

# For production (App Hosting):
# Set these environment variables in the Firebase console under App Hosting settings

