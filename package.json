{
	"name": "penny-platform",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/postbuild-apphosting-hardening.js",
		"gcp-build": "npm run build",
		"postinstall": "npm run build",
		"start": "node index.js",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"openai:test": "tsx scripts/test-openai-conversation.ts",
		"test:firestore:pipeline": "tsx scripts/test-pipeline-status.ts",
		"test:unit": "vitest run --passWithNoTests",
		"test:coverage": "vitest run --coverage --passWithNoTests",
		"test:integration": "vitest run -c vitest.integration.config.ts",
		"test:emulators": "npx firebase-tools emulators:exec --only firestore,storage \"npm run test:integration && npm --prefix services/pipeline-service run test:integration\"",
		"test:pipeline-service:unit": "npm --prefix services/pipeline-service test",
		"test:pipeline-service:coverage": "npm --prefix services/pipeline-service run test:coverage",
		"test:pipeline-service:integration": "npx firebase-tools emulators:exec --only firestore,storage \"npm --prefix services/pipeline-service run test:integration\"",
		"test:e2e:playwright": "playwright test --pass-with-no-tests",
		"test:e2e": "tsx scripts/e2e/with-emulators.ts",
		"test": "npm run test:e2e"
	},
	"devDependencies": {
		"@playwright/test": "^1.56.1",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-node": "^5.5.0",
		"@sveltejs/kit": "^2.47.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/vite": "^4.1.14",
		"@vitest/coverage-v8": "^3.2.4",
		"svelte": "^5.41.0",
		"svelte-check": "^4.3.3",
		"tailwindcss": "^4.1.14",
		"tsx": "^4.19.1",
		"typescript": "^5.9.3",
		"vite": "^7.1.10",
		"vitest": "^3.2.4"
	},
	"dependencies": {
		"@anthropic-ai/vertex-sdk": "^0.14.0",
		"@google/genai": "^1.0.0",
		"@mozilla/readability": "^0.6.0",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/typography": "^0.5.19",
		"@tiptap/core": "^3.10.7",
		"@tiptap/pm": "^3.10.7",
		"@tiptap/starter-kit": "^3.10.7",
		"firebase": "^12.7.0",
		"firebase-admin": "^13.6.0",
		"google-auth-library": "^10.5.0",
		"googleapis": "^166.0.0",
		"gsap": "^3.13.0",
		"html-to-text": "^9.0.5",
		"jsdom": "^24.0.0",
		"openai": "^5.23.2",
		"patch-package": "^8.0.1",
		"picomatch": "^4.0.3",
		"stripe": "^19.2.0",
		"vis-timeline": "^8.5.0"
	},
	"overrides": {
		"cookie": "0.7.0",
		"glob": "13.0.0",
		"jws": "4.0.1",
		"node-forge": "1.3.3",
		"qs": "6.14.1",
		"rimraf": "6.1.2"
	}
}
